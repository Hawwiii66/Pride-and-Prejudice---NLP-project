    "import matplotlib.pyplot as plt\n",
    "from collections import defaultdict\n",
    "from nltk.sentiment.vader import SentimentIntensityAnalyzer\n",
    "import math\n",
    "\n",
    "sia = SentimentIntensityAnalyzer()\n",
    "STOP_TRAITS = set([\"very\", \"more\", \"less\", \"little\", \"such\", \"next\", \"own\", \"other\", \"few\", \"much\",\"repeat\",\"ill\",\"many\",\"high\",\"natural\",\"settle\",\"real\",\"animal\",\"only\"])\n",
    "num_chunks = 25\n",
    "\n",
    "trait_sentiment_curve = defaultdict(list)\n",
    "top_traits_per_chunk = defaultdict(list)\n",
    "\n",
    "for char, sentences in character_contexts.items():\n",
    "    chunk_size = math.ceil(len(sentences) / num_chunks)\n",
    "\n",
    "    for i in range(num_chunks):\n",
    "        chunk_sents = sentences[i*chunk_size : (i+1)*chunk_size]\n",
    "        trait_scores = []\n",
    "        trait_counter = defaultdict(int)\n",
    "\n",
    "        for sent in chunk_sents:\n",
    "            if not sent.strip():\n",
    "                continue\n",
    "            sent_lower = sent.lower()\n",
    "\n",
    "            for trait in character_traits[char]:\n",
    "                t = trait.lower()\n",
    "                if t in STOP_TRAITS:\n",
    "                    continue\n",
    "                if t in sent_lower:\n",
    "                    score = sia.polarity_scores(sent)[\"compound\"]\n",
    "                    trait_scores.append(score)\n",
    "                    trait_counter[t] += 1\n",
    "\n",
    "        avg = sum(trait_scores)/len(trait_scores) if trait_scores else 0.0\n",
    "        trait_sentiment_curve[char].append(avg)\n",
    "\n",
    "        top_traits = sorted(trait_counter.items(), key=lambda x: -x[1])[:6]\n",
    "        top_traits_per_chunk[char].append([t[0] for t in top_traits])\n"
   ]
  },

    "import matplotlib.pyplot as plt\n",
    "from collections import defaultdict, Counter\n",
    "from nltk.sentiment.vader import SentimentIntensityAnalyzer\n",
    "sia = SentimentIntensityAnalyzer()\n",
    "\n",
    "\n",
    "characters = ['Mrs. Bennet', 'Mr. Bingley', 'Elizabeth Bennet', 'Mary Bennet',\n",
    "              'Lydia Bennet', 'Jane Bennet', 'Mr. Bennet', 'Mr. Darcy', 'Kitty Bennet']\n",
    "num_chunks = 25  \n",
    "top_n = 0       \n",
    "\n",
    "top_traits_per_chunk = {}\n",
    "trait_sentiment_curve = {}\n",
    "\n",
    "for char in characters:\n",
    "    trait_sentiment_curve[char] = []\n",
    "    top_traits_per_chunk[char] = []\n",
    "\n",
    "    sentences = character_contexts[char]\n",
    "    chunk_size = max(1, len(sentences) // num_chunks) \n",
    "\n",
    "    for i in range(num_chunks):\n",
    "        chunk_sents = sentences[i*chunk_size : (i+1)*chunk_size]\n",
    "        chunk_counter = Counter()\n",
    "\n",
    "        for sent in chunk_sents:\n",
    "            if not sent.strip():\n",
    "                continue\n",
    "            doc = nlp(sent)\n",
    "\n",
    "            if char.split()[0].lower() in sent.lower():\n",
    "                for token in doc:\n",
    "                    if token.pos_ == \"ADJ\":\n",
    "                        chunk_counter[token.lemma_] += 1\n",
    "\n",
    "        top_traits = [t for t,_ in chunk_counter.most_common(top_n)]\n",
    "        top_traits_per_chunk[char].append(top_traits)\n",
    "\n",
    "        total_score = 0\n",
    "        total_count = 0\n",
    "        for trait, count in chunk_counter.items():\n",
    "            score = sia.polarity_scores(trait)['compound']\n",
    "            total_score += score * count\n",
    "            total_count += count\n",
    "        avg_sentiment = total_score / total_count if total_count else 0.0\n",
    "        trait_sentiment_curve[char].append(avg_sentiment)\n",
    "\n",
    "plt.figure(figsize=(16,10))\n",
    "colors = plt.cm.tab10.colors  \n",
    "for idx, char in enumerate(characters):\n",
    "    scores = trait_sentiment_curve[char]\n",
    "    x = range(1, len(scores)+1)\n",
    "    plt.plot(x, scores, marker='o', label=char, color=colors[idx % len(colors)])\n",
    " \n",
    "    for xi, yi, traits in zip(x, scores, top_traits_per_chunk[char]):\n",
    "        if traits:\n",
    "            plt.text(xi, yi + 0.02, \", \".join(traits), fontsize=8, rotation=15, ha='center')\n",
    "\n",
    "plt.axhline(0, linestyle='--', color='gray', alpha=0.5)\n",
    "plt.title(\"Trait-Based Sentiment Development for Key Characters\")\n",
    "plt.xlabel(\"Book Chunks\")\n",
    "plt.ylabel(\"Average Trait Sentiment\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()\n"
   ]
  }

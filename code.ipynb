    "import re\n",
    "\n",
    "KNOWN_CHARACTERS = {\n",
    "    \"elizabeth\": \"Elizabeth Bennet\",\n",
    "    \"lizzy\": \"Elizabeth Bennet\",\n",
    "    \"miss elizabeth\": \"Elizabeth Bennet\",\n",
    "    \"miss bennet\": \"Elizabeth Bennet\",\n",
    "    \"jane\": \"Jane Bennet\",\n",
    "    \"darcy\": \"Mr. Darcy\",\n",
    "    \"mr darcy\": \"Mr. Darcy\",\n",
    "    \"fitzwilliam\": \"Mr. Darcy\",\n",
    "    \"bingley\": \"Mr. Bingley\",\n",
    "    \"mr bingley\": \"Mr. Bingley\",\n",
    "    \"mrs bennet\": \"Mrs. Bennet\",\n",
    "    \"mr bennet\": \"Mr. Bennet\",\n",
    "    \"lydia\": \"Lydia Bennet\",\n",
    "    \"kitty\": \"Kitty Bennet\",\n",
    "    \"mary\": \"Mary Bennet\"\n",
    "}\n",
    "\n",
    "def normalize_name(text):\n",
    "    text = text.lower()\n",
    "    text = re.sub(r\"\\[.*?\\]\", \"\", text)   # removes [Illustration]\n",
    "    text = re.sub(r\"[^a-z\\s]\", \"\", text)  # removes punctuation\n",
    "    text = text.strip()\n",
    "\n",
    "    for key, canon in KNOWN_CHARACTERS.items():\n",
    "        if key in text:\n",
    "            return canon\n",
    "    return None\n"
   ]
  },

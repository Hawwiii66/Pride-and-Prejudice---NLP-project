    "def get_main_character(doc, cluster):\n",
    "    for start, end in cluster:\n",
    "        span = doc[start:end]\n",
    "        if any(tok.pos_ == \"PROPN\" for tok in span):\n",
    "            return span.text\n",
    "    return None\n"
   ]

    "for doc in docs:\n",
    "    for cluster in doc._.coref_clusters:\n",
    "        raw_head = doc[cluster[0][0]:cluster[0][1]].text\n",
    "        char = normalize_name(raw_head)\n",
    "\n",
    "        if not char:\n",
    "            continue\n",
    "\n",
    "        for start, end in cluster:\n",
    "            span = doc[start:end]\n",
    "\n",
    "            for token in span:\n",
    "                # ADJECTIVES describing character\n",
    "                if token.dep_ == \"amod\" and token.head.text.lower() in span.text.lower():\n",
    "                    character_traits[char].append(token.lemma_)\n",
    "\n",
    "                # VERBS where character is subject\n",
    "                if token.dep_ in (\"nsubj\", \"nsubjpass\") and token.head.pos_ == \"VERB\":\n",
    "                    character_actions[char].append(token.head.lemma_)\n"
   ]

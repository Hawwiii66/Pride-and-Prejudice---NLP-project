   "source": [
    "from nltk.sentiment.vader import SentimentIntensityAnalyzer\n",
    "\n",
    "sia = SentimentIntensityAnalyzer()\n",
    "trait_sentiment_cache = {}\n",
    "\n",
    "def get_trait_sentiment(trait):\n",
    "    if trait not in trait_sentiment_cache:\n",
    "        trait_sentiment_cache[trait] = sia.polarity_scores(trait)[\"compound\"]\n",
    "    return trait_sentiment_cache[trait]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "7897e277",
   "metadata": {},
   "outputs": [],
   "source": [
    "character_trait_sentiment = defaultdict(list)\n",
    "\n",
    "for char, chunk_traits in character_chunk_traits.items():\n",
    "    for traits in chunk_traits:\n",
    "        total_score = 0.0\n",
    "        total_weight = 0\n",
    "\n",
    "        for trait, count in traits.items():\n",
    "            s = get_trait_sentiment(trait)\n",
    "            total_score += s * count\n",
    "            total_weight += count\n",
    "\n",
    "        avg = total_score / total_weight if total_weight else 0.0\n",
    "        character_trait_sentiment[char].append(avg)\n"
   ]

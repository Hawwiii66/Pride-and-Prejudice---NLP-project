    "from collections import defaultdict, Counter\n",
    "import math\n",
    "\n",
    "num_chunks = 5\n",
    "\n",
    "character_chunk_traits = defaultdict(list)\n",
    "\n",
    "for char, sentences in character_contexts.items():\n",
    "    chunk_size = math.ceil(len(sentences) / num_chunks)\n",
    "\n",
    "    for i in range(num_chunks):\n",
    "        chunk_sents = sentences[i*chunk_size:(i+1)*chunk_size]\n",
    "        trait_counter = Counter()\n",
    "\n",
    "        for sent in chunk_sents:\n",
    "            if not sent.strip():\n",
    "                continue\n",
    "            doc = nlp(sent)\n",
    "\n",
    "            if char.split()[0].lower() in sent.lower():\n",
    "                for token in doc:\n",
    "                    if token.pos_ == \"ADJ\":\n",
    "                        trait_counter[token.lemma_] += 1\n",
    "\n",
    "        character_chunk_traits[char].append(trait_counter)\n"
   ]
  },
